{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/seo-agency-rahuri",
      "destination": "/seo-services-rahuri",
      "permanent": true
    },
    {
      "source": "/google-ads-agency-rahuri",
      "destination": "/google-ads-rahuri",
      "permanent": true
